# Every value is empty on purpose. Copy this file to .env.local and fill in only what you need.
# The demo, tests and scripted suites run without any of these.

# Only the live LLM agent needs a NEAR AI Cloud key.
NEARAI_API_KEY=

# The NEAR AI Cloud base URL. Empty uses the adapter default, https://cloud-api.near.ai/v1.
NEARAI_BASE_URL=

# Pick a tool-calling model. If empty, the adapter reads /v1/model/list.
AIRBAG_MODEL=

# Suite seed for reproducible reports. Empty uses the built-in default seed, airbag-demo-2026.
AIRBAG_SEED=

# The Neon Postgres connection string. Empty uses the local JSON store at .data/airbag.json
# (fine for development and tests). Never commit a real value.
DATABASE_URL=

# The NEAR network label reported by /api/health. Empty means testnet. Signature checks are
# local and do not change per network; this only describes the intended environment.
NEAR_NETWORK=

# The NEAR network compiled into the web app at build time. Empty means testnet. Keep it equal
# to NEAR_NETWORK and rebuild the web app after changing it.
VITE_NEAR_NETWORK=

# The exact browser origin allowed to call /api with cookies, for example
# https://airbag.example.com. Empty allows only same-origin requests.
AIRBAG_ALLOWED_ORIGIN=

# The recipient string signed in the wallet sign-in message. Empty uses the request host.
AIRBAG_AUTH_RECIPIENT=

# Where the local JSON store lives when DATABASE_URL is empty. Empty means .data.
AIRBAG_DATA_DIR=
