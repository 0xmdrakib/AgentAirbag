# Optional. The demo, tests and scripted suites run without any of these.
# Only the live LLM agent needs a NEAR AI Cloud key.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1

# Pick a tool-calling model. If unset, the adapter reads /v1/model/list.
AIRBAG_MODEL=

# Suite seed for reproducible reports.
AIRBAG_SEED=airbag-demo-2026
