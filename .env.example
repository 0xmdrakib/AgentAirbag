# Optional. The demo, tests and scripted suites run without any of these.
# Only the live LLM agent needs a NEAR AI Cloud key.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1

# Pick a tool-calling model. If unset, the adapter reads /v1/model/list.
AIRBAG_MODEL=

# Suite seed for reproducible reports.
AIRBAG_SEED=airbag-demo-2026

# The Neon Postgres connection string. Leave empty to use the local JSON store
# at .data/airbag.json (fine for development and tests).
DATABASE_URL=

# The NEAR network label reported by /api/health. Signature checks are local
# and do not change per network; this only describes the intended environment.
NEAR_NETWORK=testnet

# The exact browser origin allowed to call /api with cookies, for example
# https://airbag.example.com. Leave empty to allow only same-origin requests.
AIRBAG_ALLOWED_ORIGIN=

# Where the local JSON store lives when DATABASE_URL is empty.
AIRBAG_DATA_DIR=.data

