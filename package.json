{
  "name": "airbag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crash tests for AI agents that move money: a sandboxed NEAR Intents 1Click API, 21 scripted failures, and a report card scored from ledger truth.",
  "license": "MIT",
  "homepage": "https://github.com/0xmdrakib/AgentAirbag#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xmdrakib/AgentAirbag.git"
  },
  "bugs": {
    "url": "https://github.com/0xmdrakib/AgentAirbag/issues"
  },
  "keywords": [
    "near",
    "near-intents",
    "ai-agents",
    "agent-security",
    "sandbox",
    "benchmark",
    "crash-test",
    "typescript"
  ],
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:scenarios": "tsx scripts/build-scenarios.ts",
    "build:fixtures": "tsx scripts/build-fixtures.ts",
    "build:api": "tsx scripts/build-api.ts",
    "build:site": "tsx scripts/build-site-docs.ts",
    "check:site": "tsx scripts/check-site-docs.ts",
    "build": "pnpm build:scenarios && pnpm build:fixtures && pnpm build:site && pnpm --filter @airbag/web build",
    "demo": "tsx scripts/demo.ts",
    "demo:attack": "tsx scripts/attack-demo.ts",
    "airbag": "tsx packages/server/src/cli.ts",
    "dev": "pnpm build:scenarios && pnpm build:fixtures && pnpm --filter @airbag/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run packages/server",
    "test:http": "tsx scripts/http-smoke.ts",
    "test:process": "tsx scripts/process-smoke.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "screenshots": "tsx scripts/screenshot.ts",
    "ui:interact": "tsx scripts/interact.ts",
    "ui:share": "tsx scripts/share-check.ts",
    "ui:seed": "tsx scripts/seed-check.ts",
    "ui:audit": "tsx scripts/ui-audit.ts",
    "ui:sheet": "tsx scripts/ui-sheet.ts",
    "ui:devices": "tsx scripts/ui-devices.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:api && pnpm test:http && pnpm test:process && pnpm demo:attack && pnpm llms --check && pnpm build:api --check && pnpm build && pnpm check:site && pnpm demo --smoke",
    "docs:facts": "tsx scripts/docs-facts.ts",
    "og": "tsx scripts/make-og.ts",
    "llms": "tsx scripts/build-llms.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
